function particles(r,v){let n={Common:5,Uncommon:9,Rare:15,Epic:22,Legendary:32,Mythic:45,Divine:65,Secret:110}[r]||5;if(v)n+=35;for(let i=0;i<n;i++){let p=document.createElement("div");p.className="p";p.textContent=v==="golden"?"🌟":v==="shiny"?"✨":r==="Secret"?"👑":"✦";p.style.left="50%";p.style.top="45%";p.style.setProperty("--x",(Math.random()-.5)*800+"px");p.style.setProperty("--y",(Math.random()-.5)*650+"px");$("particles").appendChild(p);setTimeout(()=>p.remove(),1600)}}
function chooseRarity(){let w={...W},L=s.luck;w.Rare*=1+L*.018;w.Epic*=1+L*.027;w.Legendary*=1+L*.04;w.Mythic*=1+L*.055;w.Divine*=1+L*.065;w.Secret*=1+L*.015;let total=R.reduce((a,x)=>a+w[x],0),x=Math.random()*total;for(const q of R){x-=w[q];if(x<=0)return q}return"Common"}
function doRoll(){if($("roll").disabled)return;const rr=chooseRarity(),pool=FOODS.filter(x=>x.rarity===rr),f=pool[Math.floor(Math.random()*pool.length)];const v=Math.random()<.003?"golden":Math.random()<.012?"shiny":"";
s.rolls++;s.currentStreak++;if(R.indexOf(f.rarity)>=2)s.rollsRare++;s.bestStreak=Math.max(s.bestStreak,s.currentStreak);let gain=PAY[f.rarity];s.coins+=gain;s.totalEarned+=gain;
if(!s.collected.includes(f.id)){s.collected.push(f.id);s.coins+=35;s.totalEarned+=35}if(v==="shiny"&&!s.shiny.includes(f.id)){s.shiny.push(f.id);s.coins+=250;s.totalEarned+=250}if(v==="golden"&&!s.golden.includes(f.id)){s.golden.push(f.id);s.coins+=750;s.totalEarned+=750}
if(R.indexOf(f.rarity)>R.indexOf(s.highest))s.highest=f.rarity;s.lastRoll={id:f.id,variant:v};save();reveal(f,v)}
let pullTimer=null;
function hidePullOverlay(){
  if(pullTimer){clearTimeout(pullTimer);pullTimer=null;}
  pullOverlay.className="pullOverlay";
  pullOverlay.style.opacity="0";
  pullOverlay.style.visibility="hidden";
  pullOverlay.style.pointerEvents="none";
}
function specialPull(f,v){
  const rare=["Legendary","Mythic","Divine","Secret"].includes(f.rarity);
  if(!rare&&!v){hidePullOverlay();return Promise.resolve();}
  return new Promise(done=>{
    if(pullTimer){clearTimeout(pullTimer);pullTimer=null;}
    pullOverlay.className="pullOverlay show "+f.rarity.toLowerCase();
    pullOverlay.style.opacity="1";
    pullOverlay.style.visibility="visible";
    pullOverlay.style.pointerEvents="auto";
    pullRarity.textContent=v?(v==="golden"?"🌟 GOLDEN ":"✨ SHINY ")+f.rarity.toUpperCase():f.rarity.toUpperCase();
    pullEmoji.textContent=f.emoji;
    pullName.textContent=f.name;
    particles(f.rarity,v);
    const ms=f.rarity==="Secret"?3000:f.rarity==="Divine"?2300:f.rarity==="Mythic"?1900:1600;
    pullTimer=setTimeout(()=>{
      hidePullOverlay();
      done();
    },ms);
  });
}
async function reveal(f,v){$("roll").disabled=true;$("rollbox").classList.add("rolling");let i=0,t=setInterval(async()=>{let q=FOODS[Math.floor(Math.random()*FOODS.length)];$("food").textContent=q.emoji;$("fname").textContent=q.name;$("rarity").textContent=q.rarity;$("rarity").className="rarity "+q.rarity.toLowerCase();if(++i>=24){clearInterval(t);$("rollbox").classList.remove("rolling");$("food").textContent=f.emoji;$("fname").textContent=f.name;$("rarity").textContent=(v?v.toUpperCase()+" • ":"")+f.rarity;$("rarity").className="rarity "+f.rarity.toLowerCase();$("result").textContent=v?(v==="golden"?"🌟 GOLDEN!":"✨ SHINY!"):"You found a "+f.rarity+"!";if(f.rarity==="Secret"){$("rollbox").classList.add("secretFx");setTimeout(()=>$("rollbox").classList.remove("secretFx"),1100)}await specialPull(f,v);toast(f.rarity==="Secret"?"👑 SECRET FOUND!":v==="golden"?"🌟 GOLDEN!":v==="shiny"?"✨ SHINY!":"🎉 "+f.name+" — "+f.rarity);$("roll").disabled=false;progress();render()}},60)}
const Q=[["q25","Roll 25 times",25,100,()=>s.rolls],["q100","Roll 100 times",100,400,()=>s.rolls],["q10","Discover 10 foods",10,150,()=>s.collected.length],["q25c","Discover 25 foods",25,500,()=>s.collected.length],["qrare","Get 10 Rare+ foods",10,350,()=>s.rollsRare],["qleg","Get 1 Legendary",1,350,()=>R.indexOf(s.highest)>=4?1:0],["qmyth","Get 1 Mythic",1,800,()=>R.indexOf(s.highest)>=5?1:0],["qdiv","Get 1 Divine",1,1500,()=>R.indexOf(s.highest)>=6?1:0],["qsec","Find a Secret",1,5000,()=>R.indexOf(s.highest)>=7?1:0],["qcoin","Earn 2500 coins",2500,500,()=>s.totalEarned],["qsh","Find a Shiny",1,600,()=>s.shiny.length],["qgo","Find a Golden",1,1200,()=>s.golden.length]];
const A=[["first","First Roll",1,()=>s.rolls],["10r","10 Rolls",10,()=>s.rolls],["100r","100 Rolls",100,()=>s.rolls],["1000r","1000 Rolls",1000,()=>s.rolls],["10c","Collect 10",10,()=>s.collected.length],["25c","Collect 25",25,()=>s.collected.length],["all","Collect All 167 Foods",FOODS.length,()=>s.collected.length],["leg","Legendary",1,()=>R.indexOf(s.highest)>=4?1:0],["myth","Mythic",1,()=>R.indexOf(s.highest)>=5?1:0],["div","Divine",1,()=>R.indexOf(s.highest)>=6?1:0],["sec","Secret",1,()=>R.indexOf(s.highest)>=7?1:0],["sh","Shiny",1,()=>s.shiny.length],["gold","Golden",1,()=>s.golden.length],["st25","25 Streak",25,()=>s.bestStreak],["st100","100 Streak",100,()=>s.bestStreak],["auto","Auto-Roll",1,()=>s.auto?1:0]];
function progress(){Q.forEach(q=>{if(q[4]()>=q[2]&&!s.quests[q[0]]){s.quests[q[0]]=1;s.coins+=q[3];s.totalEarned+=q[3];toast("🎯 Quest complete! +"+q[3])}});A.forEach(a=>{if(a[3]()>=a[2]&&!s.achievements[a[0]]){s.achievements[a[0]]=1;toast("🏆 Achievement unlocked: "+a[1])}});save()}
function applyTheme(){document.body.classList.toggle("light",!!s.lightMode);$("lightMode").checked=!!s.lightMode}
function render(){applyTheme();$("coins").textContent=s.coins.toLocaleString();$("luck").textContent=s.luck;$("rolls").textContent=s.rolls;$("streak").textContent=s.currentStreak;$("best").textContent=s.bestStreak;$("collected").textContent=s.collected.length;
if(s.lastRoll){let f=FOODS.find(x=>x.id===s.lastRoll.id);$("food").textContent=f.emoji;$("fname").textContent=f.name;$("rarity").textContent=(s.lastRoll.variant?s.lastRoll.variant.toUpperCase()+" • ":"")+f.rarity;$("rarity").className="rarity "+f.rarity.toLowerCase();equipLatest.disabled=false}
if(s.equipped){let e=FOODS.find(x=>x.id===s.equipped);$("eqEmoji").textContent=e.emoji;$("eqName").textContent=e.name}
$("auto").textContent=s.rolls>=100?(s.auto?"⏹ Turn Auto-Roll Off":"▶️ Start Auto-Roll"):"🔒 Auto-Roll Locked";$("autoInfo").textContent=s.rolls>=100?"Unlocked — "+(s.auto?"RUNNING":"off"):"Reach 100 rolls to unlock";renderCollection();renderQuests();renderAchievements();renderStats();renderShop();renderDaily()}
function renderCollection(){let term=$("search").value.toLowerCase(),f=$("filter").value;$("ccount").textContent=s.collected.length+" / "+FOODS.length+" Collected ("+Math.floor(s.collected.length/FOODS.length*100)+"%)";$("grid").innerHTML=FOODS.filter(x=>(!term||x.name.toLowerCase().includes(term))&&(f==="All"||(f==="Discovered"&&s.collected.includes(x.id))||(f==="Undiscovered"&&!s.collected.includes(x.id))||x.rarity===f)).map(x=>{let got=s.collected.includes(x.id),sh=s.shiny.includes(x.id),go=s.golden.includes(x.id);return `<div class="card ${got?"":"locked"}"><div class="badges">${sh?"✨":""}${go?" 🌟":""}${x.rarity==="Secret"?" 👑":""}</div><div class="emoji">${got?x.emoji:"❔"}</div><b>${got?x.name:"Undiscovered"}</b><small class="${x.rarity.toLowerCase()}">${got?x.rarity:"???"}</small>${got?`<button class="btn" onclick="equip(${x.id})">${s.equipped===x.id?"✅ Equipped":"🎒 Equip"}</button>`:""}</div>`}).join("")}
function equip(id){if(!s.collected.includes(id))return;s.equipped=id;save();render();toast("🎒 Equipped!")}
function renderQuests(){$("quests").innerHTML=Q.map(q=>{let v=Math.min(q[2],q[4]()),d=s.quests[q[0]];return `<div class="quest ${d?"done":""}"><div><b>${d?"✅ ":""}${q[1]}</b><div class="bar"><i style="width:${v/q[2]*100}%"></i></div><small>${v}/${q[2]}</small></div><b>+${q[3]}</b></div>`}).join("")}
function renderAchievements(){$("achievements").innerHTML=A.map(a=>`<div class="ach ${s.achievements[a[0]]?"done":""}"><span>${s.achievements[a[0]]?"🏆":"🔒"} <b>${a[1]}</b></span><span>${Math.min(a[3](),a[2])}/${a[2]}</span></div>`).join("")}
function renderStats(){let x=[["Total Rolls",s.rolls],["Coins",s.coins],["Total Coins Earned",s.totalEarned],["Luck Level",s.luck],["Current Streak",s.currentStreak],["Best Streak",s.bestStreak],["Foods Collected",s.collected.length],["Collection %",Math.floor(s.collected.length/FOODS.length*100)+"%"],["Highest Rarity",s.highest],["Shiny Count",s.shiny.length],["Golden Count",s.golden.length],["Secret Count",s.collected.filter(id=>FOODS.find(f=>f.id===id)?.rarity==="Secret").length],["Auto-Roll",s.rolls>=100?(s.auto?"On":"Off"):"Locked"]];$("statsGrid").innerHTML=x.map(a=>`<div class="stat">${a[0]}<b>${a[1]}</b></div>`).join("")}
function renderShop(){let c=Math.floor(100*Math.pow(1.7,s.luck-1));$("shop").innerHTML=`<p>Current Luck: <b>${s.luck}</b></p><button class="btn" id="buy">🍀 Upgrade Luck — ${c.toLocaleString()} coins</button><p class="hint">Rarer weights improve gradually. Secret remains extremely rare.</p>`;const buy=$("buy");buy.onclick=()=>{if(s.coins<c)return toast("Not enough coins!");s.coins-=c;s.luck++;save();render();toast("🍀 Luck upgraded!")}}
function renderDaily(){let today=new Date().toISOString().slice(0,10),claimed=s.daily===today,r=100+s.dailyCount*35;$("dailyText").textContent=claimed?"Today's reward is already claimed. Come back tomorrow!":"Today's reward: "+r.toLocaleString()+" coins.";$("dailyBtn").disabled=claimed;$("dailyBtn").onclick=()=>{if(s.daily===today)return;s.daily=today;s.dailyCount++;s.coins+=r;s.totalEarned+=r;save();render();toast("🎁 Daily reward claimed!")}}
const pages=["home","collection","quests","achievements","stats","shop","daily","credits","settings"],labels=["🎰 Roll","📖 Collection","🎯 Quests","🏆 Achievements","📊 Stats","🍀 Luck","🎁 Daily","💙 Credits","⚙️ Settings"];$("nav").innerHTML=pages.map((p,i)=>`<button class="${i===0?"on":""}" data-p="${p}">${labels[i]}</button>`).join("");$("nav").onclick=e=>{let b=e.target.closest("button");if(!b)return;pages.forEach(p=>$(p).classList.toggle("on",p===b.dataset.p));$("nav").querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));render()};$("roll").onclick=doRoll;$("equipLatest").onclick=()=>s.lastRoll&&equip(s.lastRoll.id);$("auto").onclick=()=>{if(s.rolls<100)return toast("🔒 Reach 100 rolls first!");s.auto=!s.auto;save();render()};$("search").oninput=renderCollection;$("filter").onchange=renderCollection;$("lightMode").onchange=()=>{s.lightMode=$("lightMode").checked;save();applyTheme()};$("reset").onclick=()=>{if(confirm("Reset ALL V3 progress? This cannot be undone.")){localStorage.removeItem(KEY);s=structuredClone(blank);save();render();toast("Save reset.")}};setInterval(()=>{if(s.auto&&s.rolls>=100&&!document.hidden&&!$("roll").disabled)doRoll()},1800);render();
</script></body></html>
